{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4 bg-light">
                <div class="card-body p-5 text-center">
                    <h1 class="mb-4 text-dark">Bienvenido al Sistema</h1>
                    <p class="text-muted mb-4">Seleccione una opción</p>

                    <div class="d-grid gap-3">

                        <a href="{{ path('empleados_listado') }}" class="btn btn-dark btn-lg">
                            <i class="fa-solid fa-users"></i> Empleados
                        </a>

                        <a href="{{ path('reporte_departamentos') }}" class="btn btn-secondary btn-lg">
                            <i class="fa-solid fa-building"></i> Reporte Departamentos
                        </a>

                        <a href="{{ path('reporte_paises') }}" class="btn btn-outline-dark btn-lg">
                            <i class="fa-solid fa-globe"></i> Reporte Países
                        </a>

                        <a href="{{ path('reporte_salario') }}" class="btn btn-outline-secondary btn-lg">
                            <i class="fa-solid fa-coins"></i> Reporte Salarios
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

