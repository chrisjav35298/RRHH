

{% extends 'base.html.twig' %}

{% block title %}Reporte Empleados por Departamento{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title mb-3 text-center">Empleados por Departamento</h2>
            <canvas id="empleadosDepartamentoChart" style="max-height:400px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('empleadosDepartamentoChart');
  
    console.log({{ labels|json_encode|raw }})
    console.log({{ values|json_encode|raw }})
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ labels|json_encode|raw }},
            datasets: [{
                label: 'Cantidad de empleados',
                data: {{ values|json_encode|raw }},
                backgroundColor: [
                    '#36A2EB',
                    '#FF6384',
                    '#FFCE56',
                    '#4BC0C0',
                    '#9966FF',
                    '#FF9F40'
                ],
                borderWidth: 1
            }]
        }, 
        options: {
            responsive: true,
            maintainAspectRatio: false, // tamaño se puede modificar manualmente
            plugins: {
                legend: {
                    position: 'right',
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + context.parsed.y;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });
</script>
{% endblock %}
