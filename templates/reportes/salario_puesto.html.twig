{% extends 'base.html.twig' %}

{% block title %}Salarios por Puesto{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-3 text-primary">
                        Salarios Promedio por Puesto
                    </h2>
                    <p class="text-center text-muted mb-3">
                        Visualización del salario promedio por puesto dentro de la organización.
                    </p>
                    <canvas id="salarioPuestoChart" style="max-height:400px;"></canvas>
                </div>
                <div class="card-footer text-center text-muted small">
                    Fuente: Base de datos corporativa · Actualizado {{ "now"|date("d/m/Y") }}
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('salarioPuestoChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ labels|json_encode|raw }},
            datasets: [{
                label: 'Salario promedio',
                data: {{ values|json_encode|raw }},
                backgroundColor: [
                    '#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0',
                    '#9966FF', '#FF9F40', '#8BC34A', '#E91E63'
                ],
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y', // barras sean horizontales
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const value = context.raw;
                            return context.dataset.label + ': $' + Number(value).toLocaleString();
                        }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return '$' + value.toLocaleString();
                        }
                    },
                    title: {
                        display: true,
                        text: 'Salario promedio'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Puestos'
                    }
                }
            }
        }
    });
</script>
{% endblock %}
